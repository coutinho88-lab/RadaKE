{
  "expo": {
    "name": "InstaChat",
    "slug": "instachat",
    "scheme": "instachat",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "InstaChat uses your photos when you choose media to share."
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "messages"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
